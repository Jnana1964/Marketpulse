# MarkPulse backend environment configuration.
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- Server ---
PORT=5000
NODE_ENV=development
# Comma-separated list of origins allowed to call this API (your frontend dev server, etc.)
CORS_ALLOWED_ORIGIN=http://localhost:5173

# --- Database (MySQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=markpulse

# --- Auth ---
JWT_SECRET=change_this_secret
JWT_EXPIRES_IN=7d

# --- Market data mode ---
# "live"  -> call the real Groww API (requires GROWW_API_AUTH_TOKEN below)
# "demo"  -> use the deterministic seeded instrument universe, clearly labeled DEMO DATA
MARKET_DATA_MODE=demo

# --- Groww API (https://groww.in/trade-api) ---
# A daily access token generated from your Groww account's "Trading APIs" settings.
# It expires every day at 6:00 AM IST — MarkPulse will surface this as an honest
# "market data unavailable" state rather than silently failing when it expires.
# Leave blank to run in demo mode regardless of MARKET_DATA_MODE.
GROWW_API_AUTH_TOKEN=

# --- Background snapshot job (optional, off by default) ---
# When true, periodically snapshots active users' watchlists in the
# background (see jobs/marketSnapshotJob.js). Off by default because
# user-triggered snapshots alone are enough to demo "since you last
# checked" reliably, and are much easier to reason about.
ENABLE_BACKGROUND_JOB=false
